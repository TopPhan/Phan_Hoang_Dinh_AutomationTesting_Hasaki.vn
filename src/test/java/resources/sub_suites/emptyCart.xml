<suite name="Page Object test example" parallel="none" thread-count="1">

    <listeners>
        <listener class-name="com.listener.Standard_Mode_Listener"></listener>
    </listeners>

    <test name="sample test on chrome">
        <parameter name="browserType" value="chrome" />
        <parameter name="appURL" value="https://hasaki.vn/" />
        <parameter name="email" value="${CHROME_USER}"/>
        <parameter name="password" value="${CHROME_PASS}"/>
        <classes>
            <class name="testcases.CartTest">
                <methods>
                    <include name="CartTest_DeleteAllItems"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>